  {"id": "2.19", "page": 2, "section": "B", "kind": "line", "text": "Die Besprechung beginnt um 9:30 Uhr in Raum 2.14.", "lang": "de", "box_mm": [12.0, 224.95, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["normal"], "search": ["Die", "Besprechung", "beginnt", "Uhr", "Raum"]},
  {"id": "2.20", "page": 2, "section": "B", "kind": "line", "text": "Bitte lest Kapitel 4 vor der Vorlesung.", "lang": "de", "box_mm": [12.0, 244.45, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["normal"], "search": ["Bitte", "lest", "Kapitel", "vor", "der", "Vorlesung"]},
  {"id": "2.21", "page": 2, "section": "B", "kind": "line", "text": "Die Kalman-Verstärkung wird neu berechnet.", "lang": "de", "box_mm": [12.0, 263.95, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["compound", "normal"], "search": ["Die", "Kalman-Verstärkung", "wird", "neu", "berechnet"]},
  {"id": "3.1", "page": 3, "section": "B", "kind": "line", "text": "Die Zwischenprüfung ist am 14. März 2027.", "lang": "de", "box_mm": [12.0, 41.42, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["date", "compound", "normal"], "search": ["Die", "Zwischenprüfung", "ist", "März"]},
  {"id": "3.2", "page": 3, "section": "B", "kind": "line", "text": "Der Zug fährt um 17:05 Uhr von Gleis 3.", "lang": "de", "box_mm": [12.0, 60.92, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["time", "normal"], "search": ["Der", "Zug", "fährt", "Uhr", "von", "Gleis"]},
  {"id": "3.3", "page": 3, "section": "B", "kind": "line", "text": "Er sagte: „Wir sehen uns nächste Woche.“", "lang": "de", "box_mm": [12.0, 80.42, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["quotes", "normal"], "search": ["sagte", "Wir", "sehen", "uns", "nächste", "Woche"]},
  {"id": "3.4", "page": 3, "section": "B", "kind": "line", "text": "Ca. 2,5 kg Mehl, 1 l Milch und 6 Eier.", "lang": "de", "box_mm": [12.0, 99.92, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": false, "tags": ["units", "abbreviation", "normal"], "search": ["Mehl", "Milch", "und", "Eier"]},
  {"id": "3.5", "page": 3, "section": "B", "kind": "line", "text": "Die Messung ergab 23,5 °C bei 41 % Feuchte.", "lang": "de", "box_mm": [12.0, 119.42, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["units", "normal"], "search": ["Die", "Messung", "ergab", "bei", "Feuchte"]},
  {"id": "3.6", "page": 3, "section": "B", "kind": "line", "text": "Fragen bitte an jonas.weiss@example.org", "lang": "de", "box_mm": [12.0, 138.92, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["email", "normal"], "search": ["Fragen", "bitte", "jonas.weiss@example.org"]},
  {"id": "3.7", "page": 3, "section": "B", "kind": "line", "text": "Übermorgen schließt die Bücherei früher.", "lang": "de", "box_mm": [12.0, 158.42, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["umlauts", "normal"], "search": ["Übermorgen", "schließt", "die", "Bücherei", "früher"]},
  {"id": "3.8", "page": 3, "section": "B", "kind": "line", "text": "Das Lösungsverfahren konvergiert schnell.", "lang": "de", "box_mm": [12.0, 177.92, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["compound", "normal"], "search": ["Das", "Lösungsverfahren", "konvergiert", "schnell"]},
  {"id": "3.9", "page": 3, "section": "B", "kind": "line", "text": "Größere Abweichungen bitte z. B. melden.", "lang": "de", "box_mm": [12.0, 197.42, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": false, "tags": ["abbreviation", "normal"], "search": ["Größere", "Abweichungen", "bitte", "melden"]},
  {"id": "3.10", "page": 3, "section": "B", "kind": "line", "text": "Die Brücke ist 340 m lang und 12 m breit.", "lang": "de", "box_mm": [12.0, 216.92, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["units", "normal"], "search": ["Die", "Brücke", "ist", "lang", "und", "breit"]},
  {"id": "3.11", "page": 3, "section": "B", "kind": "line", "text": "Kurz gesagt: „weniger ist mehr“.", "lang": "de", "box_mm": [12.0, 236.42, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["quotes", "normal"], "search": ["Kurz", "gesagt", "weniger", "ist", "mehr"]},
  {"id": "3.12", "page": 3, "section": "B", "kind": "line", "text": "Die Straßenbahnhaltestelle liegt gegenüber.", "lang": "de", "box_mm": [12.0, 255.92, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": true, "tags": ["compound", "umlauts", "normal"], "search": ["Die", "Straßenbahnhaltestelle", "liegt", "gegenüber"]},
  {"id": "3.13", "page": 3, "section": "B", "kind": "line", "text": "Bis nächste Woche, viele Grüße!", "lang": "de", "box_mm": [12.0, 275.42, 186.0, 10.0], "angle": 0, "x_height_mm": 3, "guides": false, "tags": ["normal"], "search": ["Bis", "nächste", "Woche", "viele", "Grüße"]},
