  {"id": "2.4", "page": 2, "section": "A", "kind": "line", "text": "Victor jagt zwölf Boxkämpfer quer über den großen Sylter Deich.", "lang": "de", "box_mm": [12.0, 75.72, 186.0, 9.0], "angle": 0, "x_height_mm": 2.5, "guides": true, "tags": ["pangram"], "search": ["Victor", "jagt", "zwölf", "Boxkämpfer", "quer", "über", "den", "großen", "Sylter", "Deich"]},
  {"id": "2.5", "page": 2, "section": "A", "kind": "line", "text": "Falsches Üben von Xylophonmusik quält jeden größeren Zwerg.", "lang": "de", "box_mm": [12.0, 94.22, 186.0, 9.0], "angle": 0, "x_height_mm": 2.5, "guides": true, "tags": ["pangram"], "search": ["Falsches", "Üben", "von", "Xylophonmusik", "quält", "jeden", "größeren", "Zwerg"]},
