{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "android-env",
      "hidden": true,
      "description": "Tool locations of the Android build. Other places: a CMakeUserPresets.json that inherits and overrides these, or qt/scripts/android-build.sh with the environment variables it documents.",
      "environment": {
        "XQT_ANDROID_SDK": "$penv{HOME}/Android/Sdk",
        "XQT_ANDROID_NDK": "$penv{HOME}/Android/Sdk/ndk/27.2.12479018",
        "XQT_QT_ANDROID": "$penv{HOME}/Qt/6.11.2/android_arm64_v8a",
        "XQT_QT_HOST": "$penv{HOME}/Qt/6.11.2/gcc_64",
        "XQT_VCPKG_ROOT": "${sourceParentDir}/../vcpkg",
        "JAVA_HOME": "$penv{HOME}/.local/jdk-17"
      }
    },
    {
      "name": "android-arm64-debug",
      "inherits": "android-env",
      "displayName": "Android arm64-v8a, debug-signed APK",
      "description": "Qt for Android's toolchain chaining vcpkg's (C dependencies, qt/vcpkg.json, static) and the NDK's. 'debug' is the APK (debug keystore, installable with adb); the native code is RelWithDebInfo so that pages draw at full speed. Build the dependencies first: qt/scripts/android-build.sh deps.",
      "generator": "Ninja",
      "binaryDir": "${sourceParentDir}/build-android",
      "toolchainFile": "$env{XQT_QT_ANDROID}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "QT_ANDROID_DEPLOYMENT_TYPE": "Debug",
        "QT_HOST_PATH": "$env{XQT_QT_HOST}",
        "ANDROID_SDK_ROOT": "$env{XQT_ANDROID_SDK}",
        "ANDROID_NDK_ROOT": "$env{XQT_ANDROID_NDK}",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_ABI": "arm64-v8a",
        "QT_ANDROID_BUILD_ALL_ABIS": "OFF",
        "QT_CHAINLOAD_TOOLCHAIN_FILE": "$env{XQT_VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{XQT_ANDROID_NDK}/build/cmake/android.toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_HOST_TRIPLET": "x64-linux-release",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceParentDir}/build-android/vcpkg_installed",
        "VCPKG_MANIFEST_INSTALL": "OFF",
        "XQT_STATIC_DEPS": "ON",
        "XQT_BUILD_TESTS": "OFF",
        "XQT_BUILD_CLI": "OFF",
        "XQT_BUILD_SPIKES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64-debug",
      "targets": ["apk"],
      "jobs": 4
    }
  ]
}
